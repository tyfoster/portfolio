// Cloudflare Workers static assets: the built site in dist/, nothing else.
// Deploy from the PERSONAL Cloudflare account.
{
  "name": "ty-foster-portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
